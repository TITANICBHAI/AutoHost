<?xml version="1.0" encoding="utf-8"?>
<!-- docs/ANDROID_MANIFEST.md §5: do NOT add android:isAccessibilityTool. No android:packageNames —
     scoping is applied dynamically by the granted packages (A11yScope). -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    <!-- P15-08 audit (RM-A8): typeWindowsChanged had zero consumers (window tracking reads the
     windows API directly) and was removed; typeViewTextChanged stays (the recorder maps it to
     Kind.TEXT); typeViewClicked is NOT in the mask even though RecorderTap maps it — recorded as
     a finding (recorder click capture) rather than a blind change. CPU effect UNMEASURED (D-25). -->
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged|typeViewTextChanged|typeNotificationStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault|flagRetrieveInteractiveWindows|flagReportViewIds|flagIncludeNotImportantViews|flagRequestFilterKeyEvents"
    android:canRetrieveWindowContent="true"
    android:canPerformGestures="true"
    android:canTakeScreenshot="true"
    tools:targetApi="30"
    android:canRequestFilterKeyEvents="true"
    android:notificationTimeout="50"
    android:description="@string/a11y_service_description"
    android:settingsActivity="app.autohost.MainActivity" />
