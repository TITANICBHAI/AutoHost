<?xml version="1.0" encoding="utf-8"?>
<!-- Projection service + consent activity (docs/ANDROID_MANIFEST.md §services). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <service
            android:name="app.autohost.capabilities.projection.ProjectionService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <activity
            android:name="app.autohost.capabilities.projection.ProjectionConsentActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
    </application>
</manifest>
