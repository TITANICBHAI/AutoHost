from typing import Any, Literal
def ask(title: str, message: str, kind: Literal["confirm", "text", "choice"] = "confirm", choices: list[str] | None = None, timeout_ms: int | None = None) -> Any: ...
def toast(text: str) -> None: ...
def dialog(title: str, message: str, buttons: list[str] | None = None) -> str: ...
def form(title: str, fields: list[dict[str, Any]]) -> dict[str, Any]: ...
def overlay(text: str, duration_ms: int = 3000) -> None: ...
def handler(name: str): ...        # decorator for task-UI callbacks
