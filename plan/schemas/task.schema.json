{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autohost.app/schemas/task.schema.json",
  "title": "AutoHost task manifest (schema v1)",
  "type": "object",
  "required": [
    "schema",
    "id",
    "name",
    "version",
    "runtime"
  ],
  "additionalProperties": false,
  "patternProperties": {
    "^x-": {}
  },
  "properties": {
    "schema": {
      "type": "integer",
      "minimum": 1,
      "description": "Manifest schema version; host migrates older ones, rejects newer (HOST_TOO_OLD)."
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9][a-z0-9-]*)+$",
      "description": "Reverse-DNS, immutable."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "author": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "host_api": {
      "type": "string",
      "description": "Range such as '>=1 <2'."
    },
    "runtime": {
      "type": "object",
      "required": [
        "type",
        "entry"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "python",
            "flow",
            "javascript"
          ]
        },
        "entry": {
          "type": "string",
          "minLength": 1
        },
        "python": {
          "type": "string"
        }
      }
    },
    "needs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/capabilityRequirement"
          }
        },
        "optional": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/capabilityRequirement"
          }
        },
        "apps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/appRequirement"
          }
        }
      }
    },
    "uses_packs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "python_deps": {
      "type": "object",
      "properties": {
        "bundled": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "vendored": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "config_schema": {
      "$ref": "#/$defs/objectSchema"
    },
    "profile_schema": {
      "$ref": "#/$defs/objectSchema"
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "triggers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "manual": {
          "type": "boolean"
        },
        "schedule": {
          "type": "object",
          "properties": {
            "allowed": {
              "type": "boolean"
            },
            "default": {
              "type": "object"
            }
          },
          "additionalProperties": false
        },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "description": "Trigger rule; see trigger-rule.schema.json"
          }
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ui_exclusive": {
          "type": "boolean"
        },
        "needs_unlocked_screen": {
          "type": "boolean"
        },
        "pausable": {
          "type": "boolean"
        },
        "timeout_minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1440
        },
        "idle_timeout_seconds": {
          "type": "integer",
          "minimum": 10,
          "default": 300
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "verification": {
          "enum": [
            "off",
            "final",
            "checkpoints",
            "strict"
          ],
          "default": "final"
        },
        "min_interval_minutes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "ui": {
      "type": "object",
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "auto",
            "declarative",
            "html"
          ]
        },
        "file": {
          "type": "string"
        }
      },
      "if": {
        "properties": {
          "mode": {
            "enum": [
              "declarative",
              "html"
            ]
          }
        }
      },
      "then": {
        "required": [
          "file"
        ]
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "runtime": {
            "properties": {
              "type": {
                "const": "flow"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "runtime": {
            "properties": {
              "entry": {
                "pattern": "\\.(ya?ml|json)$"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "runtime": {
            "properties": {
              "type": {
                "const": "python"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "runtime": {
            "properties": {
              "entry": {
                "pattern": "\\.py$"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "capabilityRequirement": {
      "type": "object",
      "required": [
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)*$"
        },
        "scope": {
          "type": "object",
          "description": "e.g. {packages:[...]}, {domains:[...]}; ${config.x}/${profile.x} allowed."
        }
      }
    },
    "appRequirement": {
      "type": "object",
      "required": [
        "package"
      ],
      "additionalProperties": false,
      "properties": {
        "package": {
          "type": "string",
          "minLength": 1
        },
        "min_version_code": {
          "type": "integer"
        }
      }
    },
    "objectSchema": {
      "type": "object",
      "properties": {
        "type": {
          "const": "object"
        },
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "properties": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "type": {
                "enum": [
                  "string",
                  "integer",
                  "number",
                  "boolean",
                  "array",
                  "object"
                ]
              },
              "title": {
                "type": "string"
              },
              "default": {},
              "enum": {
                "type": "array"
              },
              "minimum": {
                "type": "number"
              },
              "maximum": {
                "type": "number"
              },
              "x-secret": {
                "type": "boolean"
              },
              "x-ui": {
                "type": "object"
              }
            }
          }
        }
      }
    }
  }
}
