modules = ["python-3.12", "nodejs-20", "bash"]

[nix]
channel = "stable-25_05"
packages = ["gradle", "jdk17", "libyaml"]

[agent]
expertMode = true

[workflows]
runButton = "AutoHost Python verification"

[[workflows.workflow]]
name = "Push to GitHub"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/push-to-github.sh"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "AutoHost Python verification"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/test-python.sh"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "AutoHost JVM tests"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/test-jvm.sh"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "AutoHost debug APK build"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/build-android-debug.sh"

[workflows.workflow.metadata]
outputType = "console"
