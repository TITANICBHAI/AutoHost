from typing import Any, Literal
def ask(title: str, message: str, kind: Literal["confirm", "text", "choice"] = "confirm", choices: list[str] | None = None, timeout_ms: int | None = None) -> Any: ...
def toast(text: str) -> None: ...
def dialog(title: str, message: str, buttons: list[str] | None = None) -> str: ...
def form(title: str, fields: list[dict[str, Any]], timeout_ms: int | None = None) -> dict[str, Any] | None: ...
def overlay(text: str, duration_ms: int = 3000) -> dict[str, Any]: ...
def handler(name: str): ...        # decorator for task-UI callbacks
def highlight(x: int, y: int, w: int, h: int, label: str | None = None, ms: int = 2000) -> dict: ...
def panel(text: str, corner: str = "top") -> dict: ...
def overlay_clear() -> dict: ...

class console:
    LEVELS: tuple[str, ...]
    @staticmethod
    def write(text: str, level: str = "info") -> None: ...
