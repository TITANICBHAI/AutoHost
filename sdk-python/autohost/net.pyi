class ws:
    @staticmethod
    def connect(url: str, subprotocols: list[str] | None = None, timeout_ms: int = 10000) -> str: ...
    @staticmethod
    def send(handle: str, text: str) -> bool: ...
    @staticmethod
    def recv(handle: str, timeout_ms: int = 60000) -> dict: ...
    @staticmethod
    def close(handle: str) -> bool: ...

def webhook_status() -> dict: ...
def webhook_names() -> list[str]: ...
