<?xml version="1.0" encoding="utf-8"?>
<!-- X-14 (ADR-096): the network security config docs/ANDROID_MANIFEST.md §2/§5 describe.
     Base: cleartext DENIED everywhere (the platform default made explicit). Exception: the
     LOOPBACK hosts only (127.0.0.1 / localhost / the 10.0.2.2 emulator→host alias) — loopback
     cleartext never leaves the device; it serves the PC stub model over `adb reverse` and an
     on-device model server (G13-d). The RUNTIME gate is the `ai_cleartext_loopback` switch:
     BaseUrlValidator (docs/MODEL_GATEWAY §4) refuses loopback http unless the switch is on, so
     this file makes the platform ABLE to comply where the policy allows — it never widens what
     the policy permits. Every non-loopback host stays https-only. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
