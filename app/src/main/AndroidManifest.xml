<?xml version="1.0" encoding="utf-8"?>
<!-- Wave-1 manifest per docs/ANDROID_MANIFEST.md. Core flavor: no sensitive permission groups. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"
        tools:ignore="SystemPermissionTypo" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />

    <application
        android:name=".AutoHostApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_autohost"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AutoHost"
        tools:targetApi="33">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.RunForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="automation_runtime" />
        </service>

        <!-- P7-05: notify.post → notification actions (handler taps re-enter through the :ui worker) -->
        <receiver android:name=".receiver.NotificationActionReceiver" android:exported="false" />

        <!-- P7-07: generic QS tiles "AutoHost 1–5" (one component per tile; bindings in Surfaces) -->
        <service
            android:name=".surfaces.Tile1Service"
            android:exported="true"
            android:icon="@drawable/ic_autohost"
            android:label="AutoHost 1"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <service
            android:name=".surfaces.Tile2Service"
            android:exported="true"
            android:icon="@drawable/ic_autohost"
            android:label="AutoHost 2"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <service
            android:name=".surfaces.Tile3Service"
            android:exported="true"
            android:icon="@drawable/ic_autohost"
            android:label="AutoHost 3"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <service
            android:name=".surfaces.Tile4Service"
            android:exported="true"
            android:icon="@drawable/ic_autohost"
            android:label="AutoHost 4"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <service
            android:name=".surfaces.Tile5Service"
            android:exported="true"
            android:icon="@drawable/ic_autohost"
            android:label="AutoHost 5"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- P7-09: home widget (Glance) — Run button + last status -->
        <receiver
            android:name=".surfaces.TaskRunsWidgetReceiver"
            android:exported="false"
            android:label="AutoHost tasks">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/task_runs_widget_info" />
        </receiver>

        <!-- P7-08/P7-09: trampoline behind pinned shortcuts + widget Run buttons -->
        <activity
            android:name=".surfaces.SurfaceRunActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- P7-10: the ONE exported trigger surface — token-guarded RUN_TASK (plan §14) -->
        <receiver
            android:name=".surfaces.RunTaskReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="app.autohost.RUN_TASK" />
            </intent-filter>
        </receiver>

        <!-- P4-07: re-arm on boot / app update / time & timezone change / exact-alarm permission change -->
        <receiver android:name=".receiver.BootReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
        <!-- P4-05: one armed schedule fire (exact-alarm backend) -->
        <receiver android:name=".receiver.AlarmReceiver" android:exported="false" />

        <!-- P4-05/06: WorkManager fire target + periodic reconcile (~20 min, plan §11.3) -->
        <service
            android:name="androidx.work.impl.background.systemjob.SystemJobService"
            android:exported="false"
            tools:replace="android:exported"
            tools:node="merge" />

        <!-- P4-05: JobScheduler fire target -->
        <service
            android:name=".service.ScheduleFireJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- P4-10: ScreenGuard foreground service (plan §11.6) -->
        <service
            android:name="app.autohost.capabilities.screen.ScreenGuardService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="screen_guard" />
        </service>

        <!-- P8-01: notification listener (device.notifications, plan §6.1 W2). The system binds it
             when the user grants notification access; posted/removed feed the EventHub. -->
        <service
            android:name="app.autohost.capabilities.notifications.AutoHostNotificationListener"
            android:exported="false"
            android:label="AutoHost notification listener">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- P8-02: low-priority FGS hosting the dynamic event receivers while a receiver-driven
             event trigger is armed (plan §11.8 — implicit broadcasts cannot be manifest-registered). -->
        <service
            android:name=".events.EventHubService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="event_triggers" />
        </service>
        <!-- P4-10: transparent recovery activity — wakes, dismisses non-secure keyguards -->
        <activity
            android:name="app.autohost.capabilities.screen.ScreenGuardRecoveryActivity"
            android:exported="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- P5-06: ui.ask prompt dialog (WAITING_USER round trip, plan §12.3); FLAG_SECURE is set in code -->
        <activity
            android:name=".prompt.PromptActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.DeviceDefault.Dialog" />

        <!-- P8-14: the lazy permission flow (runtime permissions + SAF folder pick, plan §6.2) -->
        <activity
            android:name=".fix.PermissionRequestActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- P10-02: the visible browser surface (browser.webview) — never stealth: chrome strip
             with a Close button, launchable/stoppable by the user at any time (plan §6.1). -->
        <activity
            android:name=".browser.BrowserActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- P2-04: Open-with / share-sheet import (.aatask bundles) -->
        <activity
            android:name=".importer.ImportActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>

        <!-- P2-21: Dev API bootstrap over adb (ping / auth_token / state) -->
        <provider
            android:name=".devapi.DevApiProvider"
            android:authorities="${applicationId}.devapi"
            android:exported="false"
            android:grantUriPermissions="false" />

        <!-- Accessibility service: implementation lives in :capabilities:a11y -->
        <service
            android:name="app.autohost.capabilities.a11y.AutoHostAccessibilityService"
            android:exported="false"
            android:label="@string/a11y_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Python workers: one process each; recycled after every run -->
        <service
            android:name="app.autohost.runtime.python.worker.TaskWorkerService0"
            android:process=":w0"
            android:exported="false" />
        <service
            android:name="app.autohost.runtime.python.worker.TaskWorkerService1"
            android:process=":w1"
            android:exported="false" />
        <service
            android:name="app.autohost.runtime.python.worker.TaskWorkerService2"
            android:process=":w2"
            android:exported="false" />
        <service
            android:name="app.autohost.runtime.python.worker.TaskWorkerService3"
            android:process=":w3"
            android:exported="false" />
        <service
            android:name="app.autohost.runtime.python.worker.UiHandlerWorkerService"
            android:process=":ui"
            android:exported="false" />

        <!-- P9-08: the experimental exclusive UiAutomation runner (plan §5.4). Started through the
             shell tier with `am instrument -e port <p> …`; NEVER active while the accessibility
             service is connected (ADR-068, G9-e). targetPackage defaults to this package. -->
        <instrumentation
            android:name="app.autohost.shell.UiAutomationRunner"
            android:targetPackage="app.autohost" />

        <!-- P9-09: APK sharing for the installer-UI path (device.app.manage install mode
             "installer"); paths in res/xml/file_paths.xml. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="app.autohost.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- P11-02 (ADR-079): capability plugins expose a service with this action. -->
        <intent>
            <action android:name="app.autohost.plugin.CAPABILITY_PROVIDER" />
        </intent>
    </queries>
</manifest>
