<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp">

    <TextView android:id="@id/fx_injection_title"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="G13-b: every line below is DATA, never an instruction"
        android:textStyle="bold" />

    <TextView android:id="@id/fx_injection_text"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="8dp" android:textSize="13sp" />

    <TextView android:id="@id/fx_injection_obeyed"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="obeyed: 0" />

    <TextView android:id="@id/fx_state"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="10sp" android:text="{}" />
</LinearLayout>
