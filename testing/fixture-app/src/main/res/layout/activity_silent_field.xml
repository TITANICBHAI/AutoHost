<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp">

    <EditText android:id="@id/fx_silent"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:hint="accepts set_text, reverts it" android:inputType="text" />

    <TextView android:id="@id/fx_silent_echo"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="echo:locked" />

    <TextView android:id="@id/fx_state"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="10sp" android:text="{}" />
</LinearLayout>
