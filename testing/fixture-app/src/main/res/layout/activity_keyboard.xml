<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp">
    <EditText android:id="@id/fx_kb_field" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:hint="focus me to raise the keyboard" android:inputType="text" />
    <Button android:id="@id/fx_kb_hide" android:layout_width="match_parent" android:layout_height="56dp" android:text="Hide keyboard" />
    <TextView android:id="@id/fx_state" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="10sp" android:text="{}" />
</LinearLayout>
