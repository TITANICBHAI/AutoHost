<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp">

    <Button android:id="@id/fx_btn_continue"
        android:layout_width="match_parent" android:layout_height="64dp"
        android:text="Continue" />

    <TextView android:id="@id/fx_clicks"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="0" android:textSize="18sp" />

    <TextView android:id="@id/fx_state"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="10sp" android:text="{}" />
</LinearLayout>
