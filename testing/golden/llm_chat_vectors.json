    {"name": "length_with_tool_calls_malformed", "status": 200, "body": {"choices": [{"message": {"tool_calls": [{"id": "c", "type": "function", "function": {"name": "t", "arguments": "{\"x\":"}}]}, "finish_reason": "length"}]}, "expect": {"malformed": true}},
